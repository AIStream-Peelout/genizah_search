GCP_PROJECT_ID=hebrew-document
GCP_REGION=us-central1
VERTEX_ENDPOINT_NAME=your-endpoint-name
DEPLOYED_INDEX_ID=your-index-id
ELASTICSEARCH_SERVICEACCOUNTTOKEN=AAEAAWVsYXN0aWMva2liYW5hL2tpYmFuYS10b2tlbjo2MHR4SUJ6bVFrV0xLdDY0cExCb2pR
# Neo4j — compose (prod) on 7688, local Desktop (experimental) on default 7687
# Backend container connects via service name internally; access compose instance externally via bolt://localhost:7681
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=QqDdXKWbmTPLeKiQJRc2_prod2
# Set NEO4J_AUTH=neo4j/yourpassword to enable auth, or leave as default (none) for local dev
NEO4J_AUTH=neo4j/QqDdXKWbmTPLeKiQJRc2_prod2

# Shared API key protecting the chat / LM Studio endpoints.
# Backend reads CHAT_API_KEY (via env_file). The frontend build bakes the same
# value as REACT_APP_CHAT_API_KEY (passed as a compose build arg).
# Leave both blank to disable the check for local dev.
CHAT_API_KEY=8MaEgju6b6fkO53yHMAPMqy4wi3PdHAJM7W5BlZj16g
REACT_APP_CHAT_API_KEY=8MaEgju6b6fkO53yHMAPMqy4wi3PdHAJM7W5BlZj16g

# Idle seconds before LM Studio auto-unloads a JIT-loaded model (memory bound).
LM_STUDIO_MODEL_TTL=3600