# Copy this file to .env and replace placeholders only in your local copy.
# Never put real credentials in this example file.
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
VERTEX_ENDPOINT_NAME=your-endpoint-name
DEPLOYED_INDEX_ID=your-index-id

ELASTICSEARCH_HOST=your-elasticsearch-host
ELASTICSEARCH_USERNAME=your-elasticsearch-username
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
ELASTICSEARCH_SERVICEACCOUNTTOKEN=your-elasticsearch-service-account-token

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_AUTH=neo4j/your-neo4j-password

# Do not expose a production secret through a REACT_APP_* variable; Create
# React App embeds those variables into the browser bundle.
CHAT_API_KEY=your-server-side-chat-api-key

# Private server-side key used only by scripts/run_agentic_rag_eval.py when
# --synthesis-model is supplied. Never expose this through REACT_APP_*.
EVAL_API_KEY=your-private-evaluation-api-key

LM_STUDIO_MODEL_TTL=3600

# Offline AI transcriptions (Kraken x VLM readings served read-only from a side index)
AI_TRANSCRIPTIONS_ENABLED=true
AI_TRANSCRIPTIONS_INDEX=genizah_ai_transcriptions_v1
# Surfacing rule: show a read only if parsed AND (>= N agreed lines OR >= share agreed).
# The line agreement threshold (0.8, rule lines-v1-20260908) is fixed in code.
AI_READ_MIN_AGREED_LINES=3
AI_READ_MIN_AGREED_SHARE=0.25
